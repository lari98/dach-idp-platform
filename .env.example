# ============================================================
# DACH IDP Platform — Environment Configuration Template
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- App Mode ---
# Set to "mock" to run with no Azure credentials required
APP_MODE=mock          # options: live | mock
APP_ENV=development    # options: development | staging | production
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-secure-random-string-min-32-chars

# --- Azure Document Intelligence ---
AZURE_DOC_INTEL_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DOC_INTEL_KEY=<your-key>
# Custom model IDs (leave blank to use prebuilt models)
AZURE_INVOICE_MODEL_ID=prebuilt-invoice
AZURE_CV_MODEL_ID=prebuilt-document

# --- Azure Blob Storage ---
AZURE_STORAGE_ACCOUNT_NAME=<your-storage-account>
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_CONTAINER_INVOICES=invoices
AZURE_STORAGE_CONTAINER_CVS=cvs
AZURE_STORAGE_CONTAINER_AUDIT=audit-exports
# Retention in days (GDPR Article 17)
BLOB_RETENTION_DAYS_INVOICE=2555   # ~7 years (HGB §257 DE)
BLOB_RETENTION_DAYS_CV=365         # 1 year default

# --- Azure Key Vault (optional, recommended for production) ---
AZURE_KEYVAULT_URL=https://<your-vault>.vault.azure.net/
USE_KEYVAULT=false

# --- Azure SQL Database ---
AZURE_SQL_SERVER=<your-server>.database.windows.net
AZURE_SQL_DATABASE=dach-idp
AZURE_SQL_USERNAME=<your-user>
AZURE_SQL_PASSWORD=<your-password>
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
# For local dev, SQLite fallback
USE_SQLITE_FALLBACK=true
SQLITE_PATH=./data/dach_idp_dev.db

# --- Azure AD / Managed Identity ---
USE_MANAGED_IDENTITY=false
AZURE_TENANT_ID=<your-tenant-id>
AZURE_CLIENT_ID=<your-client-id>
AZURE_CLIENT_SECRET=<your-client-secret>

# --- GDPR Settings ---
GDPR_DATA_CONTROLLER_NAME=DACH IDP Demo GmbH
GDPR_DATA_CONTROLLER_EMAIL=datenschutz@dach-idp-demo.com
GDPR_DATA_CONTROLLER_COUNTRY=DE
GDPR_AUDIT_RETENTION_YEARS=10
GDPR_PII_MASKING_ENABLED=true
# Encryption key for PII fields at rest (Fernet key, base64)
PII_ENCRYPTION_KEY=<generate-with-cryptography.fernet.Fernet.generate_key()>

# --- Confidence Thresholds ---
INVOICE_CONFIDENCE_THRESHOLD=0.80
CV_CONFIDENCE_THRESHOLD=0.75
LOW_CONFIDENCE_FLAG_THRESHOLD=0.60

# --- Multi-language ---
DEFAULT_LANGUAGE=de   # de | en | fr | it
SUPPORTED_LANGUAGES=de,en,fr,it

# --- Power BI (optional push dataset) ---
POWERBI_WORKSPACE_ID=<your-workspace-id>
POWERBI_DATASET_ID=<your-dataset-id>
POWERBI_CLIENT_ID=<your-client-id>
POWERBI_CLIENT_SECRET=<your-client-secret>
POWERBI_TENANT_ID=<your-tenant-id>
